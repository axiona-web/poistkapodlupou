{
  "name": "poistkapodlupou",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "triggers": {
    "crons": [
      "23 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "SMTP_HOST": "smtp.m1.websupport.sk",
    "SMTP_PORT": "465",
    "SMTP_USER": "ahoj@poistkapodlupou.sk"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUDIT_QUOTA",
        "class_name": "AuditQuota"
      },
      {
        "name": "REVIEWS",
        "class_name": "ReviewStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "audit-quota-v1",
      "new_sqlite_classes": [
        "AuditQuota"
      ]
    },
    {
      "tag": "reviews-v1",
      "new_sqlite_classes": [
        "ReviewStore"
      ]
    }
  ]
}
